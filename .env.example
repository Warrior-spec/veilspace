# Server only. No real secrets belong in this file.
VEILSPACE_ENVIRONMENT=development
# Configure in milestone 2. MySQL should not be exposed publicly.
VEILSPACE_DATABASE_URL=mysql+pymysql://veilspace:CHANGE_ME@127.0.0.1:3306/veilspace
VEILSPACE_AUTH_SECRET=CHANGE_ME_BEFORE_AUTH_IS_ENABLED
VEILSPACE_STORAGE_ROOT=./storage
OPENAI_API_KEY=
# Proposed application limits, enforced when processing is implemented.
VEILSPACE_AI_DAILY_BUDGET_USD=1.00
VEILSPACE_MAX_UPLOAD_BYTES=10485760
